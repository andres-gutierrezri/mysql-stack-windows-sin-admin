# ============================================================================
# config/stack.env - Componentes y paquetes oficiales fijados (verificados 2026-10-02)
# Formato CLAVE=VALOR. Lo leen los scripts PowerShell y CMD (DRY).
#
# COMPONENTES (identificador -> producto)
#   SRV     MySQL Community Server 26.7.0 (Innovation, la mas reciente)
#   WB      MySQL Workbench 26.7.0       (la mas reciente)
#   NOTIF   MySQL Notifier 1.1.8         (producto fuera de ciclo de vida)
#   SRVLTS  MySQL Community Server 9.7.2 LTS
#   WB8     MySQL Workbench 8.0.47       (ultima de la linea 8.0, sin mantenimiento)
# GRUPOS:  ALL = todos | LATEST = SRV,WB,NOTIF | LTS = SRVLTS,WB8
#
# Los valores vacios se escriben NONE (en CMD una linea "CLAVE=" es ambigua).
#
# TIPOS (KIND): server (ZIP noinstall) | wbzip (ZIP portable) |
#               wbmsi (MSI extraido como imagen administrativa) | notifier (idem)
#
# Para actualizar una version: cambie URL, MD5 y FOLDER con los valores
# publicados en dev.mysql.com/downloads y downloads.mysql.com/archives
# ============================================================================
STACK_ROOT_DEFAULT=C:\Programs
DEFAULT_PORT=3306
DEFAULT_XPORT=33060
FALLBACK_ROOT_PASSWORD=1234567
LEGACY_LINKS=MySQL Community Server|MySQL Workbench

SRV_LABEL=MySQL Community Server 26.7.0
SRV_VERSION=26.7.0
SRV_KIND=server
SRV_URL=https://cdn.mysql.com/Downloads/MySQL-26.7/mysql-26.7.0-winx64.zip
SRV_MD5=225a7586d6a24c308b78d726a70841c6
SRV_FOLDER=mysql-26.7.0-winx64
SRV_FILE=mysql-server-26.7.0.zip
SRV_DIR=server
SRV_DATADIR=data
SRV_SUFFIX=NONE
SRV_LINK=MySQL Community Server 26.7.0
SRV_NEED_GB=3

WB_LABEL=MySQL Workbench 26.7.0
WB_VERSION=26.7.0
WB_KIND=wbzip
WB_URL=https://cdn.mysql.com/Downloads/MySQLGUITools/mysql-workbench-26.7.0-winx64.zip
WB_MD5=2fec04116d36a62d4c6f538b2ad82e1d
WB_FOLDER=NONE
WB_FILE=mysql-workbench-26.7.0.zip
WB_DIR=workbench
WB_DATADIR=NONE
WB_SUFFIX=NONE
WB_LINK=MySQL Workbench 26.7.0
WB_NEED_GB=3

NOTIF_LABEL=MySQL Notifier 1.1.8
NOTIF_VERSION=1.1.8
NOTIF_KIND=notifier
NOTIF_URL=https://cdn.mysql.com/archives/mysql-notifier/mysql-notifier-1.1.8.msi
NOTIF_MD5=9a8514a8934116fa64f5ad17101bafcd
NOTIF_FOLDER=NONE
NOTIF_FILE=mysql-notifier-1.1.8.msi
NOTIF_DIR=notifier
NOTIF_DATADIR=NONE
NOTIF_SUFFIX=NONE
NOTIF_LINK=MySQL Notifier
NOTIF_NEED_GB=1

SRVLTS_LABEL=MySQL Community Server 9.7.2 LTS
SRVLTS_VERSION=9.7.2
SRVLTS_KIND=server
SRVLTS_URL=https://cdn.mysql.com/Downloads/MySQL-9.7/mysql-9.7.2-winx64.zip
SRVLTS_MD5=657957207455a6a5b072f0d6cd1900a9
SRVLTS_FOLDER=mysql-9.7.2-winx64
SRVLTS_FILE=mysql-server-9.7.2-lts.zip
SRVLTS_DIR=server-9.7-lts
SRVLTS_DATADIR=data-9.7-lts
SRVLTS_SUFFIX=-lts
SRVLTS_LINK=MySQL Community Server 9.7.2 LTS
SRVLTS_NEED_GB=3

WB8_LABEL=MySQL Workbench 8.0.47
WB8_VERSION=8.0.47
WB8_KIND=wbmsi
WB8_URL=https://cdn.mysql.com/archives/mysql-workbench/mysql-workbench-community-8.0.47-winx64.msi
WB8_MD5=1078f06dcac442fbef82bc5dbd6c2046
WB8_FOLDER=NONE
WB8_FILE=mysql-workbench-community-8.0.47.msi
WB8_DIR=workbench-8.0.47
WB8_DATADIR=NONE
WB8_SUFFIX=NONE
WB8_LINK=MySQL Workbench 8.0.47
WB8_NEED_GB=4
