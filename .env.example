# Copie este archivo a ".env" para sobrescribir valores por defecto.
# NUNCA escriba contraseñas aquí: la contraseña de root se solicita al ejecutar.
# El archivo .env está excluido de Git (.gitignore).

# Carpeta raíz de instalación (sin espacios ni caracteres & ^ % !)
INSTALL_ROOT=C:\Programs

# Puerto TCP deseado para el PRIMER servidor que se instale en la ejecución.
# 0 = automático (3306 si no hay conflictos; si no, 3307 o superior).
MYSQL_PORT=0

# 1 = omitir MySQL Notifier (producto fuera de ciclo de vida)
SKIP_NOTIFIER=0
